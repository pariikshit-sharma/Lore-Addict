{
  "name": "lore-addict",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "packageManager": "pnpm@9.1.0",
  "scripts": {
    "dev": "turbo run dev --filter=web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:migrate": "supabase db push",
    "db:types": "supabase gen types typescript --local > packages/types/src/database.types.ts"
  },
  "devDependencies": {
    "turbo": "^2.1.0",
    "prettier": "^3.3.0",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "typescript": "^5.6.0"
  }
}
