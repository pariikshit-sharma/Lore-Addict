# ============ SUPABASE ============
# Public — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — NEVER import this into a client component or route handler
# that could leak it. Only lib/supabase/admin.ts may read this.
SUPABASE_SERVICE_ROLE_KEY=

# Local Supabase CLI only (`supabase start`) — referenced by
# supabase/config.toml's [auth.external.google]/[auth.external.discord]
# blocks so OAuth can be tested against local dev without hardcoding
# secrets into the committed config file. In production, these are set
# directly in the Supabase Dashboard (Authentication → Providers), not
# via environment variables — see DEPLOYMENT.md.
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=
SUPABASE_AUTH_DISCORD_CLIENT_ID=
SUPABASE_AUTH_DISCORD_SECRET=

# ============ AI (Anthropic) ============
# Server-only. Used by /api/ai/* for tag-suggestion and summary features.
ANTHROPIC_API_KEY=

# ============ RATE LIMITING (Upstash Redis) ============
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ============ REVALIDATION ============
# Shared secret between the CMS publish flow and /api/revalidate.
# Generate with: openssl rand -hex 32
REVALIDATE_SECRET=

# ============ CRON ============
# Vercel automatically sends this as `Authorization: Bearer $CRON_SECRET`
# on every scheduled invocation defined in vercel.json.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ============ ERROR TRACKING (Sentry) ============
# Optional until a real Sentry project exists — error.tsx logs to the
# console either way; set these to actually ship reports somewhere.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# ============ SITE ============
NEXT_PUBLIC_SITE_URL=http://localhost:3000
